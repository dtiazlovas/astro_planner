# Port the app (API + client) is served on.
PORT=5000
# SQLite file, relative to the repo root.
SQLITE_PATH=./data/astro_planner.db

# --- Access control -------------------------------------------------------
# Set API_SECRET and every request needs HTTP Basic credentials; the browser
# prompts once and remembers them. Leave it unset and the app is open, which is
# what you want on a home LAN and in local dev — but NOT on a public URL, where
# an open deployment means anyone who finds it can read and overwrite the whole
# database. Set it on Vercel.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# API_SECRET=
# Username to pair it with. Default: astro.
# API_USER=astro

# --- Vercel Blob storage (optional) ---------------------------------------
# Set BLOB_READ_WRITE_TOKEN and the SQLite file above becomes a working copy:
# it is pulled from the blob store at boot and pushed back after every write.
# Leave it unset and nothing changes — the file on disk is the database.
# Vercel injects this automatically once a Blob store is linked to the project;
# elsewhere, copy it from the store's page or run `vercel env pull`.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Pathname the database is stored under, within the store. Default:
# astro_planner.db — which is where it already sits in the astro-planner-db
# store. Only set this if the file is moved or renamed; `npm run db:list` shows
# the pathnames the store actually holds.
# BLOB_DB_KEY=astro_planner.db
# Must match how the store was created. Default: private. Only set this to
# public if the store is public — the blob is the entire database, and a public
# blob is downloadable by anyone who knows the URL.
# BLOB_DB_ACCESS=private
