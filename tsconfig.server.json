{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // deploy/** is server code too — it imports src/server with NodeNext-style
  // ".js" specifiers — so it is checked here rather than left to rot outside
  // any project. It is only ever *built* by the host that deploys it.
  "include": ["src/server", "api", "deploy"]
}
